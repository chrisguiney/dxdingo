cabal-version: 3.0
name:          dxnode-hs
version:       0.1.0.0
synopsis:      Haskell reference node for dxdingo differential testing
build-type:    Simple

common shared
  default-language: GHC2021
  ghc-options:      -Wall

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    Dxdingo.Answer
    Dxdingo.Byron
    Dxdingo.Chainsel
    Dxdingo.Codec
    Dxdingo.Convert
    Dxdingo.Crypto
    Dxdingo.Dispatch
    Dxdingo.Domain
    Dxdingo.Epoch
    Dxdingo.Fee
    Dxdingo.Gov
    Dxdingo.Net
    Dxdingo.Plutus
    Dxdingo.Praos
    Dxdingo.Rewards
    Dxdingo.Rule
    Dxdingo.Stake
    Dxdingo.Time
    Dxdingo.Wire
  build-depends:
    , base                    >=4.18 && <5
    , bimap
    , bytestring
    , cardano-binary
    , cardano-crypto-class
    , cardano-crypto-praos
    , cardano-crypto-wrapper
    , cardano-data
    , cardano-ledger-allegra
    , cardano-ledger-alonzo
    , cardano-ledger-api
    , cardano-ledger-babbage
    , cardano-ledger-binary
    , cardano-ledger-byron
    , cardano-ledger-conway
    , cardano-ledger-core     ^>=1.21
    , cardano-ledger-dijkstra
    , cardano-ledger-mary
    , cardano-ledger-shelley  ^>=1.19
    , cardano-protocol
    , cardano-protocol-tpraos ^>=1.6
    , cardano-slotting
    , cardano-strict-containers
    , cborg
    , containers
    , data-default
    , mtl
    , network-mux
    , ouroboros-consensus:{ouroboros-consensus, cardano, protocol} ^>=4.2
    , ouroboros-network:{api, protocols} ^>=1.2
    , plutus-core
    , plutus-ledger-api
    , plutus-tx
    , sop-extras
    , time
    , serialise
    , small-steps
    , sop-extras
    , time
    , transformers
    , typed-protocols
    , vector-map
    , dxnode-hs:proto
    , microlens
    , proto-lens
    , text
    , time

-- Modules generated by `make proto-hs` (proto-lens-protoc).
library proto
  import:          shared
  hs-source-dirs:  gen
  ghc-options:     -Wno-unused-imports -Wno-duplicate-exports -Wno-dodgy-exports
  exposed-modules:
    Proto.Dxdingo.V1.Byron
    Proto.Dxdingo.V1.Byron_Fields
    Proto.Dxdingo.V1.Chainsel
    Proto.Dxdingo.V1.Chainsel_Fields
    Proto.Dxdingo.V1.Codec
    Proto.Dxdingo.V1.Codec_Fields
    Proto.Dxdingo.V1.Crypto
    Proto.Dxdingo.V1.Crypto_Fields
    Proto.Dxdingo.V1.Envelope
    Proto.Dxdingo.V1.Envelope_Fields
    Proto.Dxdingo.V1.Epoch
    Proto.Dxdingo.V1.Epoch_Fields
    Proto.Dxdingo.V1.Fee
    Proto.Dxdingo.V1.Fee_Fields
    Proto.Dxdingo.V1.Gov
    Proto.Dxdingo.V1.Gov_Fields
    Proto.Dxdingo.V1.Meta
    Proto.Dxdingo.V1.Meta_Fields
    Proto.Dxdingo.V1.Net
    Proto.Dxdingo.V1.Net_Fields
    Proto.Dxdingo.V1.Plutus
    Proto.Dxdingo.V1.Plutus_Fields
    Proto.Dxdingo.V1.Praos
    Proto.Dxdingo.V1.Praos_Fields
    Proto.Dxdingo.V1.Rewards
    Proto.Dxdingo.V1.Rewards_Fields
    Proto.Dxdingo.V1.Rule
    Proto.Dxdingo.V1.Rule_Fields
    Proto.Dxdingo.V1.Service
    Proto.Dxdingo.V1.Service_Fields
    Proto.Dxdingo.V1.Stake
    Proto.Dxdingo.V1.Stake_Fields
    Proto.Dxdingo.V1.State
    Proto.Dxdingo.V1.State_Fields
    Proto.Dxdingo.V1.Time
    Proto.Dxdingo.V1.Time_Fields
    Proto.Dxdingo.V1.Types
    Proto.Dxdingo.V1.Types_Fields
  build-depends:
    , base
    , proto-lens-runtime

executable dxnode-hs
  import:         shared
  hs-source-dirs: app
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts
  build-depends:
    , base
    , dxnode-hs

test-suite dxnode-hs-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  other-modules:
    Test.Util
    Test.Wire
    Test.Codec
    Test.Rule
    Test.Fee
    Test.Plutus
    Test.Rewards
    Test.Stake
    Test.Epoch
    Test.Gov
    Test.Praos
    Test.Chainsel
    Test.Time
    Test.Byron
    Test.Crypto
    Test.Net
  build-depends:
    , base
    , bytestring
    , cardano-crypto-class
    , cardano-crypto-wrapper
    , cardano-ledger-alonzo
    , cardano-ledger-binary
    , cardano-ledger-byron
    , cardano-ledger-conway
    , cardano-ledger-core
    , cardano-ledger-dijkstra
    , cardano-ledger-mary
    , cardano-protocol
    , cardano-slotting
    , cardano-strict-containers
    , containers
    , data-default
    , ouroboros-consensus:{ouroboros-consensus, cardano} ^>=4.2
    , ouroboros-network:api ^>=1.2
    , time
    , dxnode-hs
    , ouroboros-consensus:cardano
    , dxnode-hs:proto
    , microlens
    , proto-lens
    , text
